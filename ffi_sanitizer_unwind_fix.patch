+// Returns the unwind action that newly-inserted pre/post-condition call
+// terminators must use. In a function that cannot unwind (e.g. `extern "C"`
+// with abort semantics) the MIR validator rejects `UnwindAction::Continue`,
+// so we fall back to `UnwindAction::Unreachable` there.
+fn unwind_for_block<'tcx>(tcx: TyCtxt<'tcx>, body: &Body<'tcx>) -> UnwindAction {
+    let def_id = body.source.def_id();
+    let can_unwind = if !tcx.def_kind(def_id).is_fn_like() {
+        true
+    } else {
+        let body_ty = tcx.type_of(def_id).skip_binder();
+        let body_abi = match body_ty.kind() {
+            ty::FnDef(..) => body_ty.fn_sig(tcx).abi(),
+            ty::Closure(..) => ExternAbi::RustCall,
+            ty::CoroutineClosure(..) => ExternAbi::RustCall,
+            ty::Coroutine(..) => ExternAbi::Rust,
+            _ => ExternAbi::Rust,
+        };
+        rustc_middle::ty::layout::fn_can_unwind(tcx, Some(def_id), body_abi)
+    };
+    if can_unwind {
+        UnwindAction::Continue
+    } else {
+        UnwindAction::Unreachable
+    }
+}
